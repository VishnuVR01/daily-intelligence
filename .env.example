APP_NAME=Daily Intelligence Newspaper
APP_ENV=development
APP_TIMEZONE=Europe/London

# PostgreSQL
DATABASE_URL=postgresql+psycopg://daily_intel:CHANGE_ME@localhost:5432/daily_intelligence

# Ollama AI Configuration
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120
AI_PROMPT_VERSION=v1

# OpenRouter (optional later)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Scheduling
MORNING_EDITION_HOUR=7
MORNING_EDITION_MINUTE=0

# Development Testing
ENABLE_ERROR_TEST_ROUTES=false

