APP_NAME=Daily Intelligence Newspaper
APP_ENV=development
APP_TIMEZONE=Europe/London

# PostgreSQL
DATABASE_URL=postgresql+psycopg://daily_intel:CHANGE_ME@localhost:5432/daily_intelligence

# Ollama AI Configuration
# Local Ollama (default):
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_API_KEY=
OLLAMA_TIMEOUT_SECONDS=120
AI_PROMPT_VERSION=v1

# Vercel / Cloud Ollama (set in Vercel environment variables, never commit secrets):
# OLLAMA_ENABLED=true
# OLLAMA_BASE_URL=https://ollama.com
# OLLAMA_MODEL=<supported cloud model>
# OLLAMA_API_KEY=<secret>
# OLLAMA_TIMEOUT_SECONDS=120

# OpenRouter (optional later)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Scheduling
MORNING_EDITION_HOUR=7
MORNING_EDITION_MINUTE=0

# Market Data API Key (Twelve Data or documented provider)
MARKET_DATA_API_KEY=

# Development Testing
ENABLE_ERROR_TEST_ROUTES=false

